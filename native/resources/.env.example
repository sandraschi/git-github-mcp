# git-github-mcp — Environment Configuration
# Copy this file to .env and fill in your values

# GitHub authentication (choose ONE)
# Option 1: Personal Access Token (recommended for automation)
# GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
#
# Option 2: gh CLI will use its own auth (run: gh auth login)

# Fleet configuration
# GIT_GITHUB_FLEET_REPOS_FILE=config/fleet-repos.txt
# GIT_GITHUB_DIGEST_DELIVER=file,aiwatcher

# Web interface authentication (optional)
# If set, the web dashboard will require Basic Auth
# GIT_GITHUB_WEB_USER=sandra
# GIT_GITHUB_WEB_PASS=vienna2026

# MCP bridge (optional — proxy tools from other MCP servers)
# MCP_BRIDGE_URLS=http://127.0.0.1:10795/mcp

# Advanced: sampling LLM (for agentic workflows)
# ARXIV_MCP_SAMPLING_BASE_URL=http://localhost:11434/v1
