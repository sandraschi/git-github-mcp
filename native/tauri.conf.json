{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "git-github-mcp",
    "version": "0.5.0",
    "identifier": "ai.fleet.git-github-mcp",
    "build": {
        "frontendDist": "../web/dist",
        "devUrl": "http://localhost:10703",
        "beforeDevCommand": "npm --prefix ../web run dev"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Git GitHub MCP",
                "width": 1280,
                "height": 860,
                "resizable": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:10702 http://tauri.localhost https://tauri.localhost tauri://localhost ipc: http://ipc.localhost; img-src 'self' data: http://127.0.0.1:10702; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis"],
        "icon": ["icons/icon.png", "icons/icon.ico"],
        "resources": [
            "resources/git-github-mcp-backend.exe",
            "resources/.env.example"
        ],
        "windows": {
            "webviewInstallMode": {
                "type": "skip"
            },
            "nsis": {
                "installerHooks": "./windows/hooks.nsh",
                "installMode": "currentUser"
}
        }
    },
    "plugins": {}
}


